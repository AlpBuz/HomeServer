# Copy this file to `.env` in the same directory (gitignored) and fill in real values.
# Used by AlertService to email the server owner when a container goes down.
#
# For Gmail: MAIL_USERNAME is the full address, MAIL_PASSWORD must be an
# App Password (https://myaccount.google.com/apppasswords), not your login password.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
